# =================================================================
# KnowIT Backend Environment Configuration Template (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. Application & Security
# -----------------------------------------------------------------
PROJECT_NAME=KnowIT
ENVIRONMENT=local
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_32_byte_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------
# 2. Database (PostgreSQL 17 + PGVector Extension)
# -----------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowit

# -----------------------------------------------------------------
# 3. AWS S3 Object Storage (Document Storage)
# -----------------------------------------------------------------
S3_BUCKET=knowit-documents
AWS_ACCESS_KEY_ID=AKIAYOURAWSACCESSKEY
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# -----------------------------------------------------------------
# 4. Email Service (Brevo / Sendinblue SMTP)
# -----------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=your_brevo_account_email@example.com
SMTP_PASSWORD=xsmtpsib-your_brevo_smtp_key_here
EMAILS_FROM_EMAIL=noreply@knowit.app
EMAILS_FROM_NAME=KnowIT

# -----------------------------------------------------------------
# 5. AI Providers (LLM & Embeddings)
# -----------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=mock

# -----------------------------------------------------------------
# 6. Observability (Loki & Grafana)
# -----------------------------------------------------------------
LOG_LEVEL=INFO
LOKI_URL=http://localhost:3100

# -----------------------------------------------------------------
# 7. Frontend CORS
# -----------------------------------------------------------------
FRONTEND_HOST=http://localhost:5173
